# Copy to .env and fill in whichever providers you have.
# Any model whose key is missing falls back to the offline simulator and is
# labelled SIMULATED everywhere it appears — nothing is silently substituted.

# Anthropic — Claude Opus 5 / Fable 5 / Sonnet 5 (chair-capable)
ANTHROPIC_API_KEY=

# OpenAI — GPT-5
OPENAI_API_KEY=

# Google — Gemini (via the OpenAI-compatible endpoint)
GEMINI_API_KEY=

# xAI — Grok
XAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Together AI — hosts Llama 4
TOGETHER_API_KEY=

# Alibaba DashScope — Qwen
DASHSCOPE_API_KEY=

# Moonshot AI — Kimi
MOONSHOT_API_KEY=

# Cohere — Command A (compatibility endpoint)
COHERE_API_KEY=

# Z.ai — GLM
ZAI_API_KEY=

# Perplexity — Sonar
PERPLEXITY_API_KEY=

# Amazon Bedrock (OpenAI-compatible surface) — Nova
AWS_BEARER_TOKEN_BEDROCK=

# ── app settings ───────────────────────────────────────────────
# ORCHESTRA_SIMULATE=1        # force the simulator for every model
# ORCHESTRA_CONCURRENCY=8     # max parallel model calls
# ORCHESTRA_MODELS=/path/to/models.yaml
# PORT=8000
# ORCHESTRA_TOKEN=            # require this token on /api/* — set it before
#                             # binding to 0.0.0.0 so a phone can reach the UI
# HOST=0.0.0.0                # listen on all interfaces (see README: phone)
